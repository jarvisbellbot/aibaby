# Ember Environment Variables
# Copy this file to .env and fill in your values

# Supabase (required for live mode)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Replicate AI (required for real baby generation)
EXPO_PUBLIC_REPLICATE_API_TOKEN=r8_your-token-here

# Stripe (required for subscriptions)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-key-here

# Leave all blank to run in DEMO MODE (default)
# Demo mode uses mock data — no API calls needed
